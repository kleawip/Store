# Copy to .env for local development. Never commit real credentials.
# Local Postgres.app on this machine (databases: kleawip_dev, kleawip_test).
DATABASE_URL=postgres://localhost:5432/kleawip_dev
TEST_DATABASE_URL=postgres://localhost:5432/kleawip_test
PORT=4000
HOST=127.0.0.1
# Storefront origin allowed by CORS (comma-separated for several).
STOREFRONT_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Admin session cookie is Secure (HTTPS-only) by default. Local plain-HTTP development only:
COOKIE_SECURE=false
# Proxy hops in front of the API whose X-Forwarded-For is trusted (Railway: 1). 0 locally.
TRUST_PROXY=0
# Customer sign-in codes. Without these, development writes codes to .data/otp-outbox.log.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_OTP_TEMPLATE=kleawip_login_otp
# RESEND_API_KEY=
# EMAIL_FROM=Kleawip <no-reply@kleawip.com>
# Shiprocket (without these, development uses a mock courier). Commerce defaults are TBC (ADR 0002).
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
PICKUP_PINCODE=400001
# Pickup address name as saved in the Shiprocket panel, and the x-api-key secret for its tracking webhook
# (webhook URL: https://<api>/v1/webhooks/courier — Shiprocket rejects URLs containing "shiprocket").
# SHIPROCKET_PICKUP_LOCATION=Primary
# COURIER_WEBHOOK_TOKEN=
SELLER_STATE_CODE=MH
SHIPPING_FLAT_PAISE=0
# SHIPPING_FREE_ABOVE_PAISE=
MAX_COD_BALANCE_PAISE=5000000
# Razorpay test keys (rzp_test_…). Without them development uses a local dev gateway and /v1/dev/payments/… .
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
